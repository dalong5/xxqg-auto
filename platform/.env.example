# ---- 服务 ----
PORT=8090
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_BASE_URL=http://127.0.0.1:8090

# ---- 存储 ----
DATA_DIR=./data

# ---- 安全 ----
# 32+ 字符随机串；换掉会让已存 cookie 全部失效
APP_SECRET=change-me-please-32-characters-min
# 留空 = 不校验邀请码（内测全开）；填了就只放行持码访客
INVITE_CODE=
# 每个访客最多绑定几个账号
DEFAULT_MAX_ACCOUNTS=1

# ---- 队列 ----
WORKER_CONCURRENCY=1
WORKER_NAME=w
JOB_TIMEOUT_MS=1800000
SCHEDULER_TICK_MS=60000

# ---- 领域驱动 ----
# mock  = 假数据，用于演示/测试（无需真实账号）
# xxqg  = 真实站点（需要 ../app 的领域模块与已登录 cookie）
DOMAIN_DRIVER=mock
# 可选：复用 legacy 工程里的浏览器自动化实现
LEGACY_DOMAIN_DIR=../app/src/xxqg
# 1 = 有头浏览器（本机调试用）
XXQG_HEADED=0
