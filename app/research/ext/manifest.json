{
  "manifest_version": 3,
  "name": "xxqg plain-chrome bridge",
  "version": "1.0",
  "permissions": ["cookies", "scripting", "tabs"],
  "host_permissions": ["https://*.xuexi.cn/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["https://pc.xuexi.cn/*"], "js": ["probe.js"], "run_at": "document_idle" }
  ]
}