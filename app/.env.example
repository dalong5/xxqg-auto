# 端口
PORT=8099
# 加密 cookie 的主密钥（32 字节字符串，务必自己换）
# APP_SECRET=请填入随机密钥；不设置时自动持久化到 data/secret.key
# 数据目录（sqlite + 密钥）
DATA_DIR=./data
# 单个 worker 同时跑几个账号（每个约 300MB 内存）
WORKER_CONCURRENCY=1
# 扫码并发（纯 HTTP，可以大）
LOGIN_CONCURRENCY=30
# 每个访客可绑定账号数；自用 1，开放给别人时调大
MAX_ACCOUNTS=1
# 单账号任务时长预算（毫秒）
TASK_BUDGET_MS=2700000
# 每篇材料停留秒数，低于 60 容易计不上分
DWELL_SECONDS=62
# 指定浏览器可执行文件（容器里 /usr/bin/chromium）
# CHROME_PATH=
